<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <div class="bg-white p-6 rounded-lg shadow">
    <h3 class="text-sm font-medium text-gray-500">総件数</h3>
    <p class="text-2xl font-bold text-gray-900"><%= all_deliveries.count %></p>
  </div>
  <div class="bg-white p-6 rounded-lg shadow">
    <h3 class="text-sm font-medium text-gray-500">売上合計</h3>
    <p class="text-2xl font-bold text-gray-900">¥<%= number_with_delimiter(all_deliveries.sum(:price_yen)) %></p>
  </div>
  <div class="bg-white p-6 rounded-lg shadow">
    <h3 class="text-sm font-medium text-gray-500">平均単価</h3>
    <p class="text-2xl font-bold text-gray-900">¥<%= all_deliveries.any? ? number_with_delimiter(all_deliveries.average(:price_yen).to_i) : 0 %></p>
  </div>
  <div class="bg-white p-6 rounded-lg shadow">
    <h3 class="text-sm font-medium text-gray-500">平均時間</h3>
    <p class="text-2xl font-bold text-gray-900"><%= all_deliveries.any? ? all_deliveries.average(:duration_min).to_i : 0 %>分</p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6" data-controller="charts" data-charts-update-value="true">
  <div class="bg-white p-6 rounded-lg shadow">
    <h3 class="text-lg font-medium text-gray-900 mb-4">地区別配達件数</h3>
    <div class="relative h-64">
      <canvas data-charts-target="areaDeliveryChart" 
              data-chart-data="<%= @area_delivery_counts.to_json %>"></canvas>
    </div>
  </div>

  <div class="bg-white p-6 rounded-lg shadow">
    <h3 class="text-lg font-medium text-gray-900 mb-4">地区別平均単価</h3>
    <div class="relative h-64">
      <canvas data-charts-target="areaPriceChart" 
              data-chart-data="<%= @area_avg_prices.to_json %>"></canvas>
    </div>
  </div>
</div>

<div class="bg-white rounded-lg shadow" data-controller="filter-modal">
  <div class="px-6 py-4 border-b border-gray-200">
    <div class="flex justify-between items-center">
      <h2 class="text-lg font-medium text-gray-900">最近の配達記録</h2>
      <button type="button" 
              class="inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
              data-action="click->filter-modal#open">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
        </svg>
        フィルタ
      </button>
    </div>
  </div>


  <div id="filter-modal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50" data-filter-modal-target="modal">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
      <div class="mt-3">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-lg font-medium text-gray-900">フィルタ設定</h3>
          <button type="button" 
                  class="text-gray-400 hover:text-gray-600"
                  data-action="click->filter-modal#close">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <turbo-frame id="filter-form">
          <%= render 'filter_form', areas: @areas %>
        </turbo-frame>
      </div>
    </div>
  </div>

  <%= render 'deliveries_table', deliveries: @deliveries %>
</div>
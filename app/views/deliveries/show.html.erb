<div class="max-w-4xl mx-auto p-6">
  <div class="bg-white rounded-lg shadow-sm border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold text-gray-900">配達記録詳細</h1>
        <div class="flex space-x-3">
          <%= link_to "編集", edit_delivery_path(@delivery), 
              class: "inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
          <%= link_to "削除", @delivery, method: :delete, 
              data: { confirm: "削除してもよろしいですか？" }, 
              class: "inline-flex items-center px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700" %>
          <%= link_to "一覧に戻る", dashboard_path, 
              class: "inline-flex items-center px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700" %>
        </div>
      </div>
    </div>
    
    <div class="p-6">
      <dl class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <dt class="text-sm font-medium text-gray-500">日時</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @delivery.delivered_at.strftime("%Y年%m月%d日 %H:%M") %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">地区</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @delivery.area.name %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">店舗名</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @delivery.store_name %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">料金</dt>
          <dd class="mt-1 text-sm text-gray-900">¥<%= number_with_delimiter(@delivery.price_yen) %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">時間</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @delivery.duration_min %>分</dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">メモ</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @delivery.memo.present? ? @delivery.memo : "なし" %></dd>
        </div>
      </dl>
    </div>
  </div>
</div>